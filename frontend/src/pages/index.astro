---
const API = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Visor RGB · Efecto arena</title>
	</head>
	<body data-api={API}>
		<main>

			<section class="histograms">
				<div class="charts">
          <div class="channels">
            <span class="title">Original</span>
            <figure>
              <figcaption><span class="dot dot-r"></span> Red</figcaption>
              <canvas id="hist-r-before" class="hist"></canvas>
              <div class="slider" data-channel="r">
                <div class="slider-head">Rojo (R) · recorte<output id="out-r">0%</output></div>
                <input id="eq-r" type="range" min="0" max="95" value="0" step="1" class="range range-r" />
              </div>
            </figure>

            <figure>
              <figcaption><span class="dot dot-g"></span> Green</figcaption>
              <canvas id="hist-g-before" class="hist"></canvas>
              <div class="slider" data-channel="g">
                <div class="slider-head">Verde (G) · recorte<output id="out-g">0%</output></div>
                <input id="eq-g" type="range" min="0" max="95" value="0" step="1" class="range range-g" />
              </div>
            </figure>

            <figure>
              <figcaption><span class="dot dot-b"></span> Blue</figcaption>
              <canvas id="hist-b-before" class="hist"></canvas>
              <div class="slider" data-channel="b">
                <div class="slider-head">Azul (B) · recorte<output id="out-b">0%</output></div>
                <input id="eq-b" type="range" min="0" max="95" value="0" step="1" class="range range-b" />
              </div>
            </figure>
          </div>

          <div class="channels">
            <span class="title">Procesada</span>
            <figure>
              <figcaption><span class="dot dot-r"></span> Red</figcaption>
              <canvas id="hist-r-after" class="hist"></canvas>
            </figure>

            <figure>
              <figcaption><span class="dot dot-g"></span> Green</figcaption>
              <canvas id="hist-g-after" class="hist"></canvas>
            </figure>

            <figure>
              <figcaption><span class="dot dot-b"></span> Blue</figcaption>
              <canvas id="hist-b-after" class="hist"></canvas>
            </figure>
          </div>

				</div>

				<div class="sliders">
					<div class="slider" data-channel="all">
						<div class="slider-head">
							General (RGB) · recorte
							<output id="out-all">0%</output>
						</div>
						<input id="eq-all" type="range" min="0" max="95" value="0" step="1" class="range range-all" />
						<p id="eq-hint" class="hint">R 0% · G 0% · B 0%</p>
					</div>
				</div>

				<div class="row">
					<button id="reset-btn" type="button" class="ghost">Reiniciar</button>
					<button id="download-btn" type="button" class="ghost">Descargar</button>
				</div>
			</section>

			<section class="preview">
				<div class="images">
					<figure>
						<figcaption>Original</figcaption>
						<div class="frame"><img id="img-before" alt="Imagen original" /></div>
					</figure>
					<figure>
						<figcaption>Procesada</figcaption>
						<div class="frame"><img id="img-after" alt="Imagen procesada" /></div>
					</figure>
				</div>

				<label class="file-field">
					<span>Subir imagen</span>
					<input id="file" type="file" accept="image/*" />
				</label>

				<button id="sample-btn" type="button" class="ghost">Usar imagen de ejemplo</button>
			</section>
		</main>

		<script>
			import {
				CHANNELS,
				setGeneral,
				setChannel,
				generalState,
				channelSummary,
			} from "../lib/equalize.js";

			const API = document.body.dataset.api || "http://127.0.0.1:8000";

			// Los sliders controlan el RECORTE del pico (0-95) de cada canal.
			// El recorte del pico ("pico") queda fijo en el backend (40).
			//
			// El valor del slider es la cantidad de recorte: 0 (por defecto, a la
			// izquierda) = sin recorte (nivel 100 %) y 95 (a la derecha) = recorte
			// máximo (nivel 5 %). El nivel va inverso al valor del slider.
			const DEFAULT_POS = 0; // sin recorte
			const NIVEL_MIN = 5; // nivel mínimo = recorte máximo
			const NIVEL_MAX = 100;
			const nivelDesdePos = (pos: number) => Math.min(NIVEL_MAX, Math.max(NIVEL_MIN, NIVEL_MAX - Number(pos)));

			const fileInput = document.getElementById("file") as HTMLInputElement;
			const sampleBtn = document.getElementById("sample-btn") as HTMLButtonElement;
			const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement;
			const downloadBtn = document.getElementById("download-btn") as HTMLButtonElement;
			const imgBefore = document.getElementById("img-before") as HTMLImageElement;
			const imgAfter = document.getElementById("img-after") as HTMLImageElement;
			const hintEl = document.getElementById("eq-hint") as HTMLParagraphElement;

			const sliders = {
				all: document.getElementById("eq-all") as HTMLInputElement,
				r: document.getElementById("eq-r") as HTMLInputElement,
				g: document.getElementById("eq-g") as HTMLInputElement,
				b: document.getElementById("eq-b") as HTMLInputElement,
			};
			const outputs = {
				all: document.getElementById("out-all") as HTMLOutputElement,
				r: document.getElementById("out-r") as HTMLOutputElement,
				g: document.getElementById("out-g") as HTMLOutputElement,
				b: document.getElementById("out-b") as HTMLOutputElement,
			};

			const COLORS = { r: "#ff6b6b", g: "#6ee787", b: "#7ab8ff" };

			const PAIRS = [
				{ before: "hist-r-before", after: "hist-r-after", channels: ["r"] },
				{ before: "hist-g-before", after: "hist-g-after", channels: ["g"] },
				{ before: "hist-b-before", after: "hist-b-after", channels: ["b"] },
			];

			type Hists = { r: number[]; g: number[]; b: number[] };
			type PeakInfo = { inicio: number; fin: number; umbral: number };

			let sourceBlob: Blob | null = null;
			let sourceName = "sample.png";
			let prepared: {
				width: number;
				height: number;
				histOriginal: Hists;
				peaks: { r: PeakInfo; g: PeakInfo; b: PeakInfo };
			} | null = null;
			let pct = { r: DEFAULT_POS, g: DEFAULT_POS, b: DEFAULT_POS };
			let lastHists: { before: Hists; after: Hists } | null = null;
			let renderTimer: number | undefined;
			let requestId = 0;
			let renderId = 0;

			function hexToRgba(hex: string, alpha: number) {
				const n = parseInt(hex.slice(1), 16);
				return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
			}

			function drawHistogram(
				canvas: HTMLCanvasElement,
				series: { color: string; data: number[] }[],
				yMax: number,
			) {
				const dpr = window.devicePixelRatio || 1;
				const cssW = canvas.clientWidth || 520;
				const cssH = canvas.clientHeight || 220;
				canvas.width = Math.round(cssW * dpr);
				canvas.height = Math.round(cssH * dpr);

				const ctx = canvas.getContext("2d");
				if (!ctx) return;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.clearRect(0, 0, cssW, cssH);

				const pad = { top: 12, right: 10, bottom: 20, left: 10 };
				const plotW = cssW - pad.left - pad.right;
				const plotH = cssH - pad.top - pad.bottom;

				ctx.fillStyle = "#0a080d";
				ctx.fillRect(0, 0, cssW, cssH);

				ctx.strokeStyle = "rgba(167,139,250,0.10)";
				ctx.fillStyle = "rgba(243,240,247,0.55)";
				ctx.font = "10px ui-monospace, monospace";
				ctx.textAlign = "center";
				for (let i = 0; i <= 4; i++) {
					const val = Math.round((i * 255) / 4);
					const x = pad.left + (val / 255) * plotW;
					ctx.beginPath();
					ctx.moveTo(x, pad.top);
					ctx.lineTo(x, pad.top + plotH);
					ctx.stroke();
					ctx.fillText(String(val), x, cssH - 6);
				}

				for (const s of series) {
					ctx.beginPath();
					ctx.moveTo(pad.left, pad.top + plotH);
					for (let i = 0; i < 256; i++) {
						const x = pad.left + (i / 255) * plotW;
						// Escala raíz cuadrada: deja ver a la vez el pico que baja
						// y la base que se infla (una escala lineal aplastaría la base).
						const rel = Math.min(s.data[i] / yMax, 1);
						const y = pad.top + plotH - Math.sqrt(rel) * plotH;
						ctx.lineTo(x, y);
					}
					ctx.lineTo(pad.left + plotW, pad.top + plotH);
					ctx.closePath();
					ctx.fillStyle = hexToRgba(s.color, 0.16);
					ctx.fill();
					ctx.strokeStyle = s.color;
					ctx.lineWidth = 1.2;
					ctx.stroke();
				}
			}

			function seriesFor(hist: { r: number[]; g: number[]; b: number[] }, channels: string[]) {
				return channels.map((ch) => ({
					color: COLORS[ch as keyof typeof COLORS],
					data: hist[ch as keyof typeof hist],
				}));
			}

			function renderHistograms(
				before: { r: number[]; g: number[]; b: number[] },
				after: { r: number[]; g: number[]; b: number[] },
			) {
				for (const pair of PAIRS) {
					const sBefore = seriesFor(before, pair.channels);
					const sAfter = seriesFor(after, pair.channels);
					const all: number[] = [];
					for (const s of [...sBefore, ...sAfter]) all.push(...s.data);
					// Usamos el máximo real (el pico original) para que la bajada
					// del pico sea visible; la raíz cuadrada compensa la base.
					const yMax = Math.max(...all, 1);

					const elBefore = document.getElementById(pair.before) as HTMLCanvasElement | null;
					const elAfter = document.getElementById(pair.after) as HTMLCanvasElement | null;
					if (!elBefore || !elAfter) continue;
					drawHistogram(elBefore, sBefore, yMax);
					drawHistogram(elAfter, sAfter, yMax);
				}
			}

			function syncControls(skip?: HTMLInputElement) {
				const general = generalState(pct);
				if (sliders.all !== skip && Number(sliders.all.value) !== general.value) {
					sliders.all.value = String(general.value);
				}
				outputs.all.textContent = general.label;
				outputs.all.classList.toggle("mixed", !general.synced);
				for (const ch of CHANNELS) {
					const el = sliders[ch as keyof typeof sliders];
					if (el !== skip && Number(el.value) !== pct[ch]) el.value = String(pct[ch]);
					outputs[ch as keyof typeof outputs].textContent = `${pct[ch]}%`;
				}
				hintEl.textContent = channelSummary(pct);
				hintEl.classList.toggle("mixed", !general.synced);
			}

			function render() {
				if (!prepared || !sourceBlob) return;
				const id = ++renderId;
				const form = new FormData();
				form.append("file", sourceBlob, sourceName);
				form.append("nivel_r", String(Math.round(nivelDesdePos(pct.r))));
				form.append("nivel_g", String(Math.round(nivelDesdePos(pct.g))));
				form.append("nivel_b", String(Math.round(nivelDesdePos(pct.b))));
				form.append("format", "jpeg");

				fetch(`${API}/api/process`, { method: "POST", body: form })
					.then(async (res) => {
						if (id !== renderId) return;
						if (!res.ok) {
							const text = await res.text();
							throw new Error(`El servidor respondió ${res.status}: ${text}`);
						}
						const data = await res.json();
						if (id !== renderId) return;

						imgAfter.src = data.image_after;
						lastHists = { before: prepared!.histOriginal, after: data.hist_after };
						renderHistograms(lastHists.before, lastHists.after);
					})
					.catch(() => {
						// Sin mensajes de estado.
					});
			}

			function scheduleRender() {
				window.clearTimeout(renderTimer);
				renderTimer = window.setTimeout(render, 120);
			}

			async function decodeImage(dataUrl: string) {
				const img = new Image();
				img.src = dataUrl;
				await img.decode();
				return img;
			}

			async function loadImage(blob: Blob, name: string) {
				const id = ++requestId;

				const form = new FormData();
				form.append("file", blob, name);

				try {
					const res = await fetch(`${API}/api/prepare`, { method: "POST", body: form });
					if (!res.ok) throw new Error(`El servidor respondió ${res.status}`);
					const data = await res.json();
					if (id !== requestId) return;

					const img = await decodeImage(data.image_before);
					const width = img.naturalWidth;
					const height = img.naturalHeight;

					const canvas = document.createElement("canvas");
					canvas.width = width;
					canvas.height = height;
					const ctx = canvas.getContext("2d", { willReadFrequently: true });
					if (!ctx) throw new Error("No se pudo crear el lienzo de trabajo.");
					ctx.drawImage(img, 0, 0);
					const imageData = ctx.getImageData(0, 0, width, height);

					sourceBlob = blob;
					sourceName = name;
					prepared = {
						width,
						height,
						histOriginal: data.hist_original,
						peaks: data.peaks,
					};
					imgBefore.src = data.image_before;
					render();
				} catch {
					// Sin mensajes de estado.
				}
			}

			async function loadSample() {
				try {
					const res = await fetch(`${API}/api/sample`);
					if (!res.ok) throw new Error(`El servidor respondió ${res.status}`);
					const blob = await res.blob();
					await loadImage(blob, "sample.png");
				} catch {
					// Sin mensajes de estado.
				}
			}

			fileInput.addEventListener("change", () => {
				const f = fileInput.files && fileInput.files[0];
				if (!f) return;
				loadImage(f, f.name);
			});

			sampleBtn.addEventListener("click", loadSample);

			sliders.all.addEventListener("input", () => {
				pct = setGeneral(pct, sliders.all.value);
				syncControls(sliders.all);
				scheduleRender();
			});

			for (const ch of CHANNELS) {
				const el = sliders[ch as keyof typeof sliders];
				el.addEventListener("input", () => {
					pct = setChannel(pct, ch, el.value);
					syncControls(el);
					scheduleRender();
				});
			}

			resetBtn.addEventListener("click", () => {
				pct = setGeneral(pct, DEFAULT_POS);
				syncControls();
				scheduleRender();
			});

			downloadBtn.addEventListener("click", () => {
				if (!imgAfter.src) return;
				const a = document.createElement("a");
				a.href = imgAfter.src;
				a.download =
					pct.r === 0 && pct.g === 0 && pct.b === 0
						? "imagen-original.png"
						: "imagen-arena.png";
				a.click();
			});

			window.addEventListener("resize", () => {
				if (lastHists) renderHistograms(lastHists.before, lastHists.after);
			});

			syncControls();
			loadSample();
		</script>

		<style is:global>
			:root {
				color-scheme: dark;

				/* Base negro puro */
				--bg: #0f0d13;
				--panel: #1a1721;
				--panel-2: #221e2c;
				--surface: #0a080d;
				--border: #37314a;

				/* Texto */
				--text: #f3f0f7;
				--muted: #a49db5;

				/* Acento violeta */
				--accent: #a78bfa;
				--accent-strong: #c4b5fd;
				--track: #2d2840;

				/* Estados */
				--warn-ink: #ffd28a;
				--error-ink: #ff8a80;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background-color: var(--bg);
				color: var(--text);
				font-family: "Segoe UI", system-ui, -apple-system, sans-serif;

        height: 100dvh;
        display: flex;
        flex-direction: column;
			}

			main {
				padding: 16px;
				display: grid;
				grid-template-columns: 70% minmax(0, 1fr);
				gap: 16px;
        flex: 1;

        min-height: 0;
        min-width: 0;
			}

			section {
				background: linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 14px 18px;
			}

			section h2 {
				margin: 0 0 14px;
				font-size: 1rem;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 1px;
			}

			.controls {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.file-field {
				display: flex;
				flex-direction: column;
				gap: 6px;
				font-size: 0.82rem;
				color: var(--text);
			}

			.file-field input {
				color: var(--text);
				font-size: 0.85rem;
			}

			button {
				cursor: pointer;
				border-radius: 10px;
				padding: 10px 14px;
				font-size: 0.88rem;
				border: 1px solid var(--border);
				transition: border-color 0.15s, background 0.15s;
			}

			button.ghost {
				background: var(--panel-2);
				color: var(--text);
			}

			button.ghost:hover {
				border-color: var(--accent);
				background: #282140;
			}

			.sliders {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.slider {
				padding-bottom: 4px;
			}

			.slider-head {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.82rem;
				color: var(--muted);
			}

			.slider-head output {
				margin-left: auto;
				font-family: ui-monospace, monospace;
				color: var(--text);
			}

			.slider-head output.mixed {
				color: var(--warn-ink);
			}

			.hint {
				margin: 6px 0 0;
				font-size: 0.75rem;
				font-family: ui-monospace, monospace;
				color: var(--muted);
			}

			.hint.mixed {
				color: var(--warn-ink);
			}

			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				display: inline-block;
			}

			.dot-r { background: #ff6b6b; }
			.dot-g { background: #6ee787; }
			.dot-b { background: #7ab8ff; }
			.dot-all { background: linear-gradient(135deg, #ff6b6b, #6ee787, #7ab8ff); }

			input[type="range"] {
				width: 100%;
				-webkit-appearance: none;
				appearance: none;
				height: 6px;
				border-radius: 999px;
				background: var(--track);
				outline: none;
				/* Natural: a la izquierda 0 (corte arriba, 100 %) y baja hacia la derecha. */
			}

			input[type="range"]::-webkit-slider-thumb {
				-webkit-appearance: none;
				appearance: none;
				width: 16px;
				height: 16px;
				border-radius: 50%;
				border: 2px solid var(--surface);
				cursor: pointer;
			}

			input[type="range"]::-moz-range-thumb {
				width: 14px;
				height: 14px;
				border-radius: 50%;
				border: 2px solid var(--surface);
				cursor: pointer;
			}

			.range-all::-webkit-slider-thumb { background: var(--accent); }
			.range-r::-webkit-slider-thumb { background: #ff6b6b; }
			.range-g::-webkit-slider-thumb { background: #6ee787; }
			.range-b::-webkit-slider-thumb { background: #7ab8ff; }
			.range-all::-moz-range-thumb { background: var(--accent); }
			.range-r::-moz-range-thumb { background: #ff6b6b; }
			.range-g::-moz-range-thumb { background: #6ee787; }
			.range-b::-moz-range-thumb { background: #7ab8ff; }

			.row {
				display: flex;
				gap: 10px;
			}

			.row button {
				flex: 1;
			}

      .preview {
        display: flex;
        flex-direction: column;
        gap: 12px;

        min-height: 0;
        min-width: 0;
      }

			.preview .images {
        display: grid;
        grid-template-rows: repeat(2, minmax(0, 1fr));
        gap: 10px;

        flex: 1;
        min-height: 0;
			}

      .preview figure {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 6px;

        min-height: 0;
        min-width: 0;
      }

			figure {
				margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
			}

      .slider .slider-head,
      figure figcaption
      {
        padding-left: 3px;
      }

			figcaption {
				font-size: 0.82rem;
				color: var(--muted);
			}

			figcaption .dot {
				vertical-align: middle;
			}

			figcaption small {
				color: var(--muted);
			}

			.frame {
        width: 100%;
        aspect-ratio: 4 / 3;

        min-width: 0;
        min-height: 0;
        max-height: 100%;

				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 12px;
				overflow: hidden;

				display: flex;
				align-items: center;
				justify-content: center;
			}

			.frame img {
				max-width: 100%;
				max-height: 100%;
				display: block;
			}

      .histograms {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

			.charts {
        display: flex;
        flex-direction: column;
        gap: 8px;
			}

      .charts .channels {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        column-gap: 16px;
      }

      .channels span.title {
        grid-column: 1 / -1;
        font-size: 0.82rem;
        color: var(--text);
        margin-bottom: 6px;
        display: block;
      }

			canvas.hist {
				width: 100%;
				height: 200px;
				border: 1px solid var(--border);
				border-radius: 12px;
				display: block;
			}

			.legend {
				display: flex;
				gap: 16px;
				list-style: none;
				margin: 10px 0 0;
				padding: 0;
				font-size: 0.78rem;
				color: var(--muted);
			}

			.legend li {
				display: flex;
				align-items: center;
				gap: 6px;
			}

			@media (max-width: 900px) {
				main {
					grid-template-columns: 1fr;
				}
				.controls {
